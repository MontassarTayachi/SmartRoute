            ],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/{{created_vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vehicles", "{{created_vehicle_id}}"]
            }
          }
        }
      ]
    },
